      ]
    },
    {
      "name": "image-prompt",
      "source": "./features/image-prompt",
      "description": "Composition-aware Midjourney and NijiJourney prompt generation for any subject or style.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/image-prompt",
