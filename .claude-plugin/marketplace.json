{
  "$schema": "https://code.claude.com/schemas/marketplace.json",
  "name": "recall",
  "description": "Persistent, file-based memory for AI coding agents. Markdown only — no runtime, no dependencies.",
  "version": "1.0.0",
  "owner": {
    "name": "Muhd Mirza",
    "url": "https://github.com/mhdmirzaa"
  },
  "metadata": {
    "pluginRoot": "./features"
  },
  "plugins": [
    {
      "name": "merge",
      "source": "./features/merge",
      "description": "Collapses identity and profile into one memory file so a session loads once instead of twice, and ships a patch system for stale references.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/merge",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "foundation",
      "keywords": [
        "memory",
        "consolidation",
        "startup",
        "patches"
      ]
    },
    {
      "name": "time-aware",
      "source": "./features/time-aware",
      "description": "Reads the real clock and adapts greeting, energy and focus to morning, afternoon, evening or night. Stamps memory entries with the actual time.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/time-aware",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "foundation",
      "keywords": [
        "time",
        "greeting",
        "context",
        "timestamps"
      ]
    },
    {
      "name": "hook-session-start",
      "source": "./features/hook-session-start",
      "description": "Installs a SessionStart hook so memory loads the moment Claude Code opens, without typing the AI name first. Fully reversible.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/hook-session-start",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "foundation",
      "keywords": [
        "hook",
        "startup",
        "automation",
        "claude-code"
      ]
    },
    {
      "name": "hook-user-prompt",
      "source": "./features/hook-user-prompt",
      "description": "One UserPromptSubmit hook that runs every script in an injectors directory and prepends their output to each prompt. The framework the inject-* features plug into.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/hook-user-prompt",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "foundation",
      "keywords": [
        "hook",
        "framework",
        "injection",
        "claude-code"
      ]
    },
    {
      "name": "inject-tone",
      "source": "./features/inject-tone",
      "description": "Injects the active tone into every prompt from a registry kept in memory. Add, set and list tones at runtime. Requires hook-user-prompt.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/inject-tone",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "foundation",
      "keywords": [
        "tone",
        "injector",
        "prompt",
        "register"
      ]
    },
    {
      "name": "inject-mood",
      "source": "./features/inject-mood",
      "description": "Injects the active mood into every prompt from a registry kept in memory. Add, set and list moods at runtime. Requires hook-user-prompt.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/inject-mood",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "foundation",
      "keywords": [
        "mood",
        "injector",
        "prompt"
      ]
    },
    {
      "name": "inject-time",
      "source": "./features/inject-time",
      "description": "Injects a timestamp and day period into every prompt, with a one-shot signal when the period flips. Boundaries chosen at install. Requires hook-user-prompt.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/inject-time",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "foundation",
      "keywords": [
        "time",
        "injector",
        "prompt",
        "period"
      ]
    },
    {
      "name": "session-log",
      "source": "./features/session-log",
      "description": "Writes a dated entry into memory history at the end of a session, with monthly archival. The record everything else searches.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/session-log",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "memory",
      "keywords": [
        "diary",
        "history",
        "documentation",
        "archive"
      ]
    },
    {
      "name": "topic-notes",
      "source": "./features/topic-notes",
      "description": "Subject-based notes that outlive the calendar, for discoveries and fixes that belong to a topic rather than a day.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/topic-notes",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "memory",
      "keywords": [
        "notes",
        "topics",
        "knowledge",
        "memory"
      ]
    },
    {
      "name": "trim",
      "source": "./features/trim",
      "description": "Budget-aware compaction. Summarises old entries into a dense history block instead of deleting them, with reversible snapshots.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/trim",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "memory",
      "keywords": [
        "compaction",
        "budget",
        "context",
        "memory"
      ]
    },
    {
      "name": "search",
      "source": "./features/search",
      "description": "Searches past session entries and answers as narrative. Never fabricates a memory it did not find; asks when it finds nothing.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/search",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "memory",
      "keywords": [
        "recall",
        "search",
        "history",
        "memory"
      ]
    },
    {
      "name": "reminders",
      "source": "./features/reminders",
      "description": "Follow-ups that survive across sessions, with deadline tracking, kept separate from working memory so they are never overwritten.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/reminders",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "memory",
      "keywords": [
        "reminders",
        "followup",
        "deadlines"
      ]
    },
    {
      "name": "decisions",
      "source": "./features/decisions",
      "description": "Append-only record of non-obvious decisions and the reasoning behind them, so past trade-offs stay answerable.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/decisions",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "memory",
      "keywords": [
        "decisions",
        "rationale",
        "log",
        "architecture"
      ]
    },
    {
      "name": "projects",
      "source": "./features/projects",
      "description": "Ten active project slots with least-recently-used archival, so project context is tracked without unbounded growth.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/projects",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "development",
      "keywords": [
        "projects",
        "lru",
        "tracking",
        "management"
      ]
    },
    {
      "name": "git-commit",
      "source": "./features/git-commit",
      "description": "Structured git commits carrying session context, so history documents the work rather than just the file changes.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/git-commit",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "development",
      "keywords": [
        "git",
        "commit",
        "automation",
        "history"
      ]
    },
    {
      "name": "work-plan",
      "source": "./features/work-plan",
      "description": "Turns a plan into tracked checkboxes with a commit per task, so an interrupted session can be resumed exactly where it stopped.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/work-plan",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "development",
      "keywords": [
        "planning",
        "execution",
        "tasks",
        "git"
      ]
    },
    {
      "name": "library",
      "source": "./features/library",
      "description": "Reusable knowledge entries in eight fixed formats. Save a pattern once and install it into any project.",
      "version": "1.0.1",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/library",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "development",
      "keywords": [
        "library",
        "patterns",
        "knowledge",
        "reuse"
      ]
    },
    {
      "name": "code-audit",
      "source": "./features/code-audit",
      "description": "Four-tier code review: survey, investigate, refine, audit. Assess project health before planning or after implementing.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/code-audit",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "development",
      "keywords": [
        "review",
        "audit",
        "code-quality",
        "analysis"
      ]
    },
    {
      "name": "new-skill",
      "source": "./features/new-skill",
      "description": "Detects patterns handled ad hoc three or more times and proposes a new skill for them, with a human approving every one.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/new-skill",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "intelligence",
      "keywords": [
        "skills",
        "automation",
        "self-improvement"
      ]
    },
    {
      "name": "session-brief",
      "source": "./features/session-brief",
      "description": "Delivers a short context brief at the start of every session: where you left off, open reminders, project health, time of day.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/session-brief",
      "repository": "https://github.com/mhdmirzaa/recall",
      "license": "MIT",
      "category": "intelligence",
      "keywords": [
        "briefing",
        "startup",
        "context",
        "summary"
      ]
    },
    {
      "name": "postmortem",
      "source": "./features/postmortem",
      "description": "A failure log that detects, records and later references mistakes, so the same problem does not cost you twice.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
      },
      "homepage": "https://github.com/mhdmirzaa/recall/tree/main/features/postmortem",
