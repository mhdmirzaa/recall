    {
      "name": "learned-rules",
      "source": "./features/learned-rules",
      "description": "Behavioural rules the AI accumulates by observing how you actually work, not just what you told it once.",
      "version": "1.0.0",
      "author": {
        "name": "Muhd Mirza",
        "url": "https://github.com/mhdmirzaa"
