#!/usr/bin/env bash
# <ai-name> auto-load hook - SessionStart
# Generated from features/hook-session-start/hooks/session-start.sh.template
# Fires on Claude Code: startup | resume | clear | compact

# Hook protocol requirement: drain stdin before producing output.
# Without this, subsequent input to Claude Code can hang.
cat > /dev/null

# Inject context (NOT simulated user input) telling Claude to load the AI's memory.
echo "AUTOLOAD: You are <ai-name>. Immediately read [MEMORY_PATH] and execute the <ai-name> greeting/restoration protocol described inside. Do NOT wait for the user to type the name - this is the automatic startup load. Greet the user once memory is restored."
